# /etc/default/reasni 或 /etc/reasni/daemon.env
# RC 引擎 24 小时全网 ASN 扫描守护进程参数配置

# 守护进程启动参数：
# - 嵌入式设备 (NanoPi / 树莓派 / Armbian / 内存<2G)：建议 -t 100~150，避免占满家用路由器 NAT 连接表
# - 高性能 VPS / 服务器：可设为 -t 300~500
# 说明：内置 HTTP API 与 Web 控制台已移除，--port/--host/--token/--no-http 不再生效，请勿写入
DAEMON_OPTS="-t 150 --interval 10"

# 配置文件绝对路径（默认自动读取 /etc/reasni/config.yaml）
REALITY_CONFIG="/etc/reasni/config.yaml"
